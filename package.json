{
  "name": "bffi-rs",
  "version": "0.1.3",
  "private": true,
  "description": "Bun-only native binding framework (Rust)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/z2net/bffi-rs.git"
  },
  "bugs": {
    "url": "https://github.com/z2net/bffi-rs/issues",
    "email": "contact@z2net.com"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "codegen": "bun packages/bffi-cli/bin/bffi.ts codegen",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "test": "cargo test --workspace",
    "build": "cargo build --release -p bffi-native",
    "test:js": "bun test packages",
    "check": "bun run lint && bun run typecheck && cargo check --workspace",
    "ci": "bun run lint && bun run typecheck && bun run fmt:check && bun run clippy && bun run test && bun run test:js"
  },
  "devDependencies": {
    "lefthook": "2.1.12",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "@types/bun": "1.4.2"
  }
}
