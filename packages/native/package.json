{
  "name": "@z2net/bffi-native",
  "version": "0.2.3",
  "description": "The bffi-rs reference native module: prebuilt cdylibs for win32-x64/arm64, linux-x64/arm64 (glibc and musl) and darwin-x64/aarch64, loaded through the @z2net/bffi typed loader.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z2net/bffi-rs.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/z2net/bffi-rs/issues",
    "email": "contact@z2net.com"
  },
  "author": {
    "name": "z2net",
    "email": "contact@z2net.com"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "bffi",
    "bun",
    "ffi",
    "native",
    "rust"
  ],
  "dependencies": {
    "@z2net/bffi": "0.2.3"
  },
  "optionalDependencies": {
    "@z2net/bffi-native-win32-x64-msvc": "0.2.3",
    "@z2net/bffi-native-win32-arm64-msvc": "0.2.3",
    "@z2net/bffi-native-linux-x64-gnu": "0.2.3",
    "@z2net/bffi-native-linux-x64-musl": "0.2.3",
    "@z2net/bffi-native-linux-arm64-gnu": "0.2.3",
    "@z2net/bffi-native-linux-arm64-musl": "0.2.3",
    "@z2net/bffi-native-darwin-aarch64": "0.2.3",
    "@z2net/bffi-native-darwin-x64": "0.2.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
