# ===== Rust =====
# `target` at any depth: the root workspace target/ and any nested one.
target/
**/*.rs.bk
Cargo.lock

# ===== Bun / JS =====
node_modules/
.bun/
*.tsbuildinfo
*.log
# pattern-A platform packages are assembled artifacts (bffi pack)
packages/native/platform/

# ===== OS =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ===== Editors / IDEs =====
.idea/
*.swp
*.swo
*~

# ===== VS Code (keep shared configs, ignore personal) =====
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# ===== Zed (keep shared, ignore personal) =====
.zed/*
!.zed/settings.json
!.zed/tasks.json
!.zed/debug.json

# ===== Personal AI / agent tooling (NEVER commit) =====
.grok/
.claude/
.zcode/
.codex/
.opencode/
.hermes/
.mcp/
.cursor/
.aider*
.continue/
.windsurf/
.firecrawl/
.agent/
.agents/
.specs/
.memory/
.local/
.mimosa/

# ===== Secrets & env =====
.env
.env.*
!.env.example
!.env.sample
secrets/
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# ===== Test / temp =====
# Test scaffolds create `tmp/` under their own package (check-doctor,
# build): the whole tree stays out of git.
tmp/
*.tmp

# ===== Patch debris =====
*.orig
*.rej
