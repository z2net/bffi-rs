{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Monorepo resolution: internal imports use the package names
    // (`@z2net/bffi`, `@z2net/bffi/*`, ...) instead of relative hops;
    // until publication the names map onto the local sources (Bun's
    // runtime honors tsconfig paths too).
    "paths": {
      "@z2net/bffi": ["./packages/bffi/src/index.ts"],
      "@z2net/bffi/*": ["./packages/bffi/src/*"],
      "@z2net/bffi-cli": ["./packages/bffi-cli/src/index.ts"],
      "@z2net/bffi-cli/*": ["./packages/bffi-cli/src/*"]
    }
  }
}
